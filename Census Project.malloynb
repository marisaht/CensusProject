#CREATING NEW TABLE THAT COMPARES ALL 4 PERSON FAMILY INCOME AVERAGES IN EACH STATE
source: FourPersonIncomes is duckdb.sql("""
  SELECT 
    state,
    cast(value as DOUBLE) as income
  FROM (
    SELECT *
    FROM read_csv_auto('Family_Income_Size.csv')
    WHERE FamilySize = '4-person families'
  )
  UNPIVOT (
    value FOR state IN (
      Alabama, Alaska, Arizona, Arkansas, California, Colorado, Connecticut,
      Delaware, "District of Columbia", Florida, Georgia, Hawaii, Idaho, Illinois,
      Indiana, Iowa, Kansas, Kentucky, Louisiana, Maine, Maryland, Massachusetts,
      Michigan, Minnesota, Mississippi, Missouri, Montana, Nebraska, Nevada,
      "New Hampshire", "New Jersey", "New Mexico", "New York", "North Carolina",
      "North Dakota", Ohio, Oklahoma, Oregon, Pennsylvania, "Rhode Island",
      "South Carolina", "South Dakota", Tennessee, Texas, Utah, Vermont,
      Virginia, Washington, "West Virginia", Wisconsin, Wyoming
    )
  )
""")

>>>malloy
#TABLE SHOWING 4 PERSON FAMILY INCOME AVERAGES IN EACH STATE, FROM HIGHEST TO LOWEST
run: FourPersonIncomes -> {
  group_by: state
  aggregate: avg_income is avg(income)
  order_by: avg_income desc
}
>>>malloy
#BAR CHART SHOWING 4 PERSON FAMILY INCOME AVERAGES IN EACH STATE, FROM HIGHEST TO LOWEST
# bar_chart
run: FourPersonIncomes -> {
  group_by: state
  aggregate: avg_income is avg(income)
  order_by: avg_income desc
}
>>>malloy

